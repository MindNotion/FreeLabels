{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: Package (build the jar)",
      "type": "shell",
      "command": "mvn",
      "args": ["package"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Installer: Windows (.exe)",
      "type": "shell",
      "command": "packaging\\windows\\build-installer.bat",
      "args": ["exe"],
      "dependsOn": "Maven: Package (build the jar)",
      "problemMatcher": [],
      "windows": { "command": "packaging\\windows\\build-installer.bat" }
    },
    {
      "label": "Installer: Windows (.msi)",
      "type": "shell",
      "command": "packaging\\windows\\build-installer.bat",
      "args": ["msi"],
      "dependsOn": "Maven: Package (build the jar)",
      "problemMatcher": [],
      "windows": { "command": "packaging\\windows\\build-installer.bat" }
    },
    {
      "label": "Installer: macOS (.dmg)",
      "type": "shell",
      "command": "./packaging/macos/build-installer.sh",
